{
    "name": "lyrkstack",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "lint": "eslint .",
        "preview": "vite preview",
        "format": "prettier --write \"**/*.+(ts|tsx|json|yml|yaml|css|md|vue|json)\"",
        "prepare": "husky install",
        "report": "npx playwright show-report",
        "e2e": "docker compose run --rm playwright",
        "compose": "docker compose build --no-cache",
        "up": "docker compose up",
        "test": "vitest run",
        "test:watch": "vitest",
        "server": "node api/server.ts"
    },
    "husky": {
        "hooks": {
            "pre-commit": "echo linting and formatting staged changes && lint-staged"
        }
    },
    "lint-staged": {
        "*.+(ts|tsx|json|yml|yaml|css|md|vue|json)": [
            "npm run lint",
            "npm run format"
        ]
    },
    "dependencies": {
        "axios": "1.15.2",
        "cors": "2.8.5",
        "dotenv": "17.2.4",
        "express": "5.2.1",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "react-icons": "5.5.0",
        "react-router-dom": "7.13.0",
        "sql.js": "1.14.1",
        "sqlite": "5.1.1",
        "sqlite3": "5.1.7"
    },
    "devDependencies": {
        "@eslint/js": "9.35.0",
        "@playwright/test": "1.57.0",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/react": "16.3.2",
        "@types/cors": "2.8.19",
        "@types/express": "5.0.6",
        "@types/node": "25.0.9",
        "@types/react": "19.1.13",
        "@types/react-dom": "19.1.9",
        "@types/sql.js": "1.4.11",
        "@vitejs/plugin-react": "5.0.2",
        "@vitest/coverage-v8": "^4.1.10",
        "eslint": "9.35.0",
        "eslint-plugin-import": "2.32.0",
        "eslint-plugin-react-hooks": "5.2.0",
        "eslint-plugin-react-refresh": "0.4.20",
        "globals": "16.4.0",
        "husky": "9.1.7",
        "identity-obj-proxy": "3.0.0",
        "lint-staged": "16.2.1",
        "prettier": "3.6.2",
        "typescript": "5.8.3",
        "typescript-eslint": "8.43.0",
        "vite": "7.1.6",
        "vitest": "4.1.10"
    }
}
