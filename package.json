{
    "name": "lyrkstack",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "lint": "eslint .",
        "preview": "vite preview",
        "format": "prettier --write \"**/*.+(ts|tsx|json|yml|yaml|css|md|vue|json)\"",
        "prepare": "husky install",
        "report": "npx playwright show-report",
        "compose": "docker compose build --no-cache",
        "up": "docker compose up",
        "test": "npm run compose && npm run up"
    },
    "husky": {
        "hooks": {
            "pre-commit": "echo linting and formatting staged changes && lint-staged"
        }
    },
    "lint-staged": {
        "*.+(ts|tsx|json|yml|yaml|css|md|vue|json)": [
            "npm run lint",
            "npm run format"
        ]
    },
    "dependencies": {
        "@fortawesome/free-solid-svg-icons": "^7.0.1",
        "@fortawesome/react-fontawesome": "^3.0.2",
        "@types/cors": "^2.8.19",
        "axios": "^1.13.2",
        "cors": "^2.8.5",
        "express": "^5.2.1",
        "fa-icons": "^0.2.0",
        "font-awesome": "^4.7.0",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "react-icons": "^5.5.0",
        "react-router-dom": "^7.9.1",
        "serve": "^14.2.5",
        "sqlite": "^5.1.1",
        "sqlite3": "^5.1.7"
    },
    "devDependencies": {
        "@eslint/js": "^9.35.0",
        "@playwright/test": "^1.57.0",
        "@types/express": "^5.0.6",
        "@types/node": "^25.0.9",
        "@types/react": "^19.1.13",
        "@types/react-dom": "^19.1.9",
        "@vitejs/plugin-react": "^5.0.2",
        "eslint": "^9.35.0",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.20",
        "globals": "^16.4.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.1",
        "prettier": "^3.6.2",
        "typescript": "~5.8.3",
        "typescript-eslint": "^8.43.0",
        "vite": "^7.1.6"
    }
}
