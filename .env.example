NETWORK_MODE=host

# Optional: override the database storage directory. Leave unset to use the
# per-OS user data dir 
# (Linux: ~/.local/share/lyrk-stack, 
# macOS: ~/Library/Application Support/lyrk-stack, 
# Windows: %APPDATA%\lyrk-stack). 
# Docker sets this to /app/data.
# LYRK_DATA_DIR=

# React env vars
VITE_CLIENT_BASE_URL=http://localhost:5173
VITE_SERVER_BASE_URL=http://localhost:3001
VITE_SONGS_URL=/api/data/songs
VITE_SONG_LYRICS_URL=/api/data/songLyrics
